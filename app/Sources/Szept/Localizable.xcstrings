    "Dodaj kontakt, pokazując swój kod QR albo skanując cudzy. Bez numerów, bez listy znajomych na serwerze.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a contact by showing your QR code or scanning theirs. No phone numbers, no friend list on the server."
          }
        }
      }
    },
    "Dodaj osoby": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add people"
          }
        }
      }
